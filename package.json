{
    "name": "tanstack-start-example-basic",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "bun run --bun vite dev",
        "build": "bun run --bun vite build",
        "start": "bun run server.ts",
        "lint": "biome check",
        "type-check": "bun run --bun tsc && echo 'Types verified'",
        "test:unit": "bun test tests/unit",
        "test:e2e": "bun run build && bun run --bun playwright test",
        "test:e2e:dev": "E2E_SERVER=development bun run --bun playwright test",
        "build:data": "bun ./tools/fetcher.ts",
        "build:image": "bun ./tools/preloadImage.ts",
        "build:ugoira": "bun ./tools/ugoira.ts",
        "db:init": "bun ./tools/dbInit.ts"
    },
    "dependencies": {
        "@heroicons/react": "2.2.0",
        "@tanstack/react-router": "1.170.44",
        "@tanstack/react-start": "1.169.1",
        "@tanstack/react-router-devtools": "1.167.2",
        "clsx": "2.1.1",
        "dotenv": "16.5.0",
        "drizzle-kit": "0.30.6",
        "drizzle-orm": "0.41.0",
        "lodash": "4.17.21",
        "mem": "10.0.0",
        "pixiv.ts": "0.7.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-select": "5.10.2",
        "sharp": "0.34.1",
        "swr": "2.3.3",
        "web-api-hooks": "3.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@tailwindcss/vite": "4.3.3",
        "@playwright/test": "1.64.0",
        "@vitejs/plugin-react": "6.1.2",
        "@types/bun": "1.2.9",
        "@types/lodash": "4.17.16",
        "@types/node": "22.14.1",
        "@types/react": "19.1.2",
        "@types/react-dom": "19.1.2",
        "daisyui": "5.0.19",
        "p-queue": "8.1.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    },
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": ">=1.4.3",
        "node": ">=22.12.0"
    }
}
